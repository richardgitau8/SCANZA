rules_version = '2';

// SCANZA AI — Cloud Storage Security Rules
//
// Layout:
//   uploads/{uid}/{scanId}/{filename}   — files clients submit for scanning
//   reports/{uid}/{scanId}/{filename}   — generated reports (server-only writes)
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isAllowedDoc() {
      return request.resource.size <= 25 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf' ||
          request.resource.contentType == 'application/msword' ||
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        );
    }

    // Files uploaded by users for scanning — owner only, verified only, type/size enforced
    match /uploads/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) && isVerified();
      allow create, update: if isOwner(uid) && isVerified() && isAllowedDoc();
      allow delete: if isOwner(uid);
    }

    // Generated reports — owner reads only; only the server may write
    match /reports/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) && isVerified();
      allow write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
